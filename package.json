{
  "name": "pamphlet-reader-vue3-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @your-org/vue-flipbook build && pnpm --filter flipbook-vue-playground dev",
    "dev:nuxt": "pnpm --filter @your-org/vue-flipbook build && pnpm --filter flipbook-nuxt-playground dev",
    "build": "pnpm --filter @your-org/vue-flipbook build",
    "build:apps": "pnpm --filter flipbook-vue-playground build && pnpm --filter flipbook-nuxt-playground build",
    "typecheck": "pnpm --filter @your-org/vue-flipbook typecheck && pnpm --filter flipbook-vue-playground typecheck && pnpm --filter flipbook-nuxt-playground typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:package": "node scripts/verify-package.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures": "node scripts/create-fixtures.mjs",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.8",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-tsc": "^3.1.1"
  }
}
